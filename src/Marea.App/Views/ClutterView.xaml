<UserControl x:Class="Marea.App.Views.ClutterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Marea.App">
    <UserControl.Resources>
        <DataTemplate x:Key="ClutterCard">
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="22" Background="{StaticResource SeaTintBrush}"
                            Margin="0,0,16,0" VerticalAlignment="Top">
                        <Path Data="{Binding Icon}" Style="{StaticResource IcoLarge}" Fill="{Binding Brush}" />
                    </Border>
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top" Margin="12,0,0,0">
                        <TextBlock Text="{Binding Size}" FontWeight="SemiBold" FontSize="18" HorizontalAlignment="Right" Margin="0,0,0,8" />
                        <Button Tag="{Binding Command}" Click="OnCopy" Padding="12,6" Margin="0,0,0,6" Visibility="{Binding CopyVisibility}"
                                HorizontalAlignment="Right" AutomationProperties.Name="{l:T clutter.copy}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Copy}" Style="{StaticResource Ico}" Margin="0,0,6,0" />
                                <TextBlock Text="{l:T clutter.copy}" />
                            </StackPanel>
                        </Button>
                        <Button Tag="{Binding Folder}" Click="OnOpen" Padding="12,6" HorizontalAlignment="Right"
                                AutomationProperties.Name="{l:T clutter.open}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Open}" Style="{StaticResource Ico}" Margin="0,0,6,0" />
                                <TextBlock Text="{l:T clutter.open}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="{Binding Display}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" ToolTip="{Binding Path}" />
                        <TextBlock Text="{Binding Advice}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding Notes}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding NotesVisibility}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="0,0,8,12">
            <TextBlock Text="{l:T clutter.title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T clutter.subtitle}" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button x:Name="MeasureButton" Style="{StaticResource AccentButtonStyle}" Click="OnMeasure" Padding="14,7"
                        AutomationProperties.Name="{l:T clutter.measure}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Sync}" Style="{StaticResource Ico}" Margin="0,0,8,0" />
                        <TextBlock Text="{l:T clutter.measure}" />
                    </StackPanel>
                </Button>
                <ProgressBar x:Name="Busy" IsIndeterminate="True" Width="120" Height="4" Margin="16,0,0,0" VerticalAlignment="Center"
                             Visibility="Collapsed" />
                <TextBlock x:Name="Status" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <ItemsControl x:Name="Reclaimable" Focusable="False" ItemTemplate="{StaticResource ClutterCard}" />
            <TextBlock x:Name="OtherTitle" Text="{l:T clutter.other}" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" Visibility="Collapsed" />
            <ItemsControl x:Name="Other" Focusable="False" ItemTemplate="{StaticResource ClutterCard}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
