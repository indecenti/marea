<UserControl x:Class="Marea.App.Views.ModelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Marea.App">
    <Grid Margin="0,0,8,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{l:T models.title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T models.subtitle}" Style="{StaticResource PageSubtitle}" />
            <Button x:Name="RollbackChip" Click="OnShowRollback" Padding="12,5" Margin="0,0,0,12" HorizontalAlignment="Left"
                    Visibility="Collapsed" ToolTip="{l:T models.rollback_chip_tip}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.History}" Style="{StaticResource Ico}" Width="14" Height="14" Margin="0,0,6,0" />
                    <TextBlock x:Name="RollbackText" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Toolbar: search, filter, totals -->
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <Border x:Name="AttentionChip" DockPanel.Dock="Right" CornerRadius="14" Padding="12,5" VerticalAlignment="Center"
                    Background="{StaticResource WarningBrush}" Visibility="Collapsed" Margin="12,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.ShieldError}" Style="{StaticResource Ico}" Fill="White" Width="14" Height="14" Margin="0,0,6,0" />
                    <TextBlock x:Name="AttentionText" Foreground="White" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="TotalText" DockPanel.Dock="Right" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0" />
            <Button x:Name="FreeUnusedButton" DockPanel.Dock="Right" Click="OnFreeUnused" Padding="12,6" Margin="8,0,0,0" VerticalAlignment="Center"
                    Visibility="Collapsed" Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="{l:T models.free_unused}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Broom}" Style="{StaticResource Ico}" Margin="0,0,6,0" />
                    <TextBlock x:Name="FreeText" Text="{l:T models.free_unused}" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Click="OnCheckSources" Padding="12,6" Margin="8,0,0,0" VerticalAlignment="Center"
                    ToolTip="{l:T models.check_sources_tip}" AutomationProperties.Name="{l:T models.check_sources}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Globe}" Style="{StaticResource Ico}" Margin="0,0,6,0" />
                    <TextBlock Text="{l:T models.check_sources}" />
                </StackPanel>
            </Button>
            <ComboBox x:Name="Filter" DockPanel.Dock="Right" Width="250" SelectionChanged="OnFilter" AutomationProperties.Name="{l:T models.filter}" />
            <Grid MinWidth="160" Margin="0,0,8,0">
                <TextBox x:Name="Search" Padding="30,6,8,6" TextChanged="OnSearch" VerticalContentAlignment="Center"
                         AutomationProperties.Name="{l:T models.search}" />
                <Path Data="{StaticResource Icon.Search}" Style="{StaticResource Ico}" Width="14" Height="14"
                      HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" Opacity="0.7" />
                <TextBlock x:Name="SearchHint" Text="{l:T models.search}" Style="{StaticResource Caption}" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
        </DockPanel>

        <Grid Grid.Row="2">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="48"
                      HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single"
                      SelectionChanged="OnSelection" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{l:T col.model}" Width="*" MinWidth="200" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel VerticalAlignment="Center" Margin="6,0">
                                    <Path DockPanel.Dock="Left" Data="{StaticResource Icon.Cube}" Style="{StaticResource Ico}" Fill="{Binding KindBrush}" Margin="0,0,10,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}" />
                                        <TextBlock Text="{Binding Kind}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Kind}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{l:T col.format}" Binding="{Binding Format}" Width="150" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{l:T col.params}" Binding="{Binding Params}" Width="100" SortMemberPath="ParamCount" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{l:T col.size}" Binding="{Binding Size}" Width="85" SortMemberPath="Bytes" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{l:T col.state}" Binding="{Binding State}" Width="105" ElementStyle="{StaticResource CellText}" />
                    <DataGridTemplateColumn Header="{l:T col.source}" Width="180" SortMemberPath="SourceRank">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                    <Path Data="{Binding SourceIcon}" Style="{StaticResource Ico}" Fill="{Binding SourceBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Source}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Source}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{l:T col.safety}" Width="180" SortMemberPath="SafetyRank">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                    <Path Data="{Binding SafetyIcon}" Style="{StaticResource Ico}" Fill="{Binding SafetyBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Safety}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyText" Text="{l:T models.empty}" Style="{StaticResource Caption}" FontSize="14" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="460" Visibility="Collapsed" />
        </Grid>

        <!-- Detail of the selected model -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
            <DockPanel>
                <Border x:Name="DetailBadge" DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20" Margin="0,0,14,0"
                        VerticalAlignment="Top" Background="{StaticResource SeaAccentBrush}">
                    <Path x:Name="DetailIcon" Data="{StaticResource Icon.Cube}" Style="{StaticResource Ico}" Width="20" Height="20" Fill="White" />
                </Border>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top">
                    <Button x:Name="OpenButton" Click="OnOpenFolder" Padding="12,6" HorizontalAlignment="Stretch"
                            IsEnabled="False" AutomationProperties.Name="{l:T models.open_folder}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Open}" Style="{StaticResource Ico}" Margin="0,0,6,0" />
                            <TextBlock Text="{l:T models.open_folder}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RescueButton" Click="OnRescue" Padding="12,6" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                            Visibility="Collapsed" Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="{l:T models.rescue}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.CloudDown}" Style="{StaticResource Ico}" Margin="0,0,6,0" />
                            <TextBlock Text="{l:T models.rescue}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ProtectButton" Click="OnProtect" Padding="12,6" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                            Visibility="Collapsed" AutomationProperties.Name="{l:T models.protect}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Server}" Style="{StaticResource Ico}" Margin="0,0,6,0" />
                            <TextBlock Text="{l:T models.protect}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock x:Name="DetailTitle" Text="{l:T models.select_title}" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DetailText" Text="{l:T models.select_hint}" TextWrapping="Wrap" LineHeight="20" />
                    <TextBlock x:Name="DetailFiles" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" FontFamily="Consolas" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
