<Window x:Class="Marea.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Marea.App"
        Title="Marea" Width="1200" Height="800" MinWidth="940" MinHeight="620"
        Icon="pack://application:,,,/Assets/marea.ico"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="NavText" TargetType="TextBlock">
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navigation -->
        <DockPanel Grid.RowSpan="2" Background="{DynamicResource LayerFillColorDefaultBrush}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,18,26">
                <Image Source="pack://application:,,,/Assets/marea.png" Width="38" Height="38" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Marea" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="{l:T app.tagline}" Style="{StaticResource Caption}" />
                </StackPanel>
            </StackPanel>
            <Border DockPanel.Dock="Bottom" Margin="14" Padding="12,10" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <DockPanel>
                    <Border x:Name="ProviderBadge" DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="15" Margin="0,0,10,0" VerticalAlignment="Top">
                        <Path x:Name="ProviderIcon" Style="{StaticResource Ico}" Fill="White" />
                    </Border>
                    <StackPanel>
                        <TextBlock x:Name="ProviderText" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock x:Name="ProviderDetail" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <ListBox x:Name="Nav" BorderThickness="0" Background="Transparent" Margin="10,0"
                     SelectionChanged="OnNavigate" KeyboardNavigation.TabNavigation="Once">
                <ListBoxItem Tag="overview" Padding="12,10" AutomationProperties.Name="{l:T nav.overview}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Home}" Style="{StaticResource Ico}" />
                        <TextBlock Text="{l:T nav.overview}" Style="{StaticResource NavText}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="models" Padding="12,10" AutomationProperties.Name="{l:T nav.models}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Cube}" Style="{StaticResource Ico}" />
                        <TextBlock Text="{l:T nav.models}" Style="{StaticResource NavText}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="files" Padding="12,10" AutomationProperties.Name="{l:T nav.files}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Documents}" Style="{StaticResource Ico}" />
                        <TextBlock Text="{l:T nav.files}" Style="{StaticResource NavText}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="clutter" Padding="12,10" AutomationProperties.Name="{l:T nav.clutter}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Broom}" Style="{StaticResource Ico}" />
                        <TextBlock Text="{l:T nav.clutter}" Style="{StaticResource NavText}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="folders" Padding="12,10" AutomationProperties.Name="{l:T nav.folders}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource Ico}" />
                        <TextBlock Text="{l:T nav.folders}" Style="{StaticResource NavText}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="journal" Padding="12,10" AutomationProperties.Name="{l:T nav.activity}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.History}" Style="{StaticResource Ico}" />
                        <TextBlock Text="{l:T nav.activity}" Style="{StaticResource NavText}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="settings" Padding="12,10" AutomationProperties.Name="{l:T nav.settings}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Settings}" Style="{StaticResource Ico}" />
                        <TextBlock Text="{l:T nav.settings}" Style="{StaticResource NavText}" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </DockPanel>

        <ContentControl x:Name="Page" Grid.Column="1" Margin="36,28,36,12" Focusable="False" />

        <!-- Long-running operations bar -->
        <Border x:Name="OpBar" Grid.Column="1" Grid.Row="1" Visibility="Collapsed" Padding="36,12"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path Data="{StaticResource Icon.Sync}" Style="{StaticResource IcoLarge}" Fill="{StaticResource SeaAccentBrush}" Margin="0,0,14,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="OpTitle" FontWeight="SemiBold" />
                    <TextBlock x:Name="OpDetail" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <ProgressBar x:Name="OpProgress" Height="4" Margin="0,6,0,0" Maximum="1" />
                </StackPanel>
                <Button x:Name="OpCancel" Grid.Column="2" Content="{l:T op.cancel}" Margin="16,0,0,0" Click="OnCancel" />
            </Grid>
        </Border>
        <Border x:Name="HydBar" Grid.Column="1" Grid.Row="1" Visibility="Collapsed" Padding="36,10"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <DockPanel>
                <Path DockPanel.Dock="Left" Data="{StaticResource Icon.CloudDown}" Style="{StaticResource Ico}" Fill="{StaticResource EvaporatedBrush}" Margin="0,0,12,0" />
                <StackPanel>
                    <TextBlock x:Name="HydText" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <ProgressBar x:Name="HydProgress" Height="3" Margin="0,4,0,0" Maximum="1" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
