<Project Sdk="Microsoft.NET.Sdk">
  <!-- Marea engine: provenance ledger, sources, safety rules, tide policy. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <!-- Native SQLite pinned past GHSA-2m69-gcr7-jv3q (2.1.11 is vulnerable). -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Windows: Cloud Files. Linux (net10.0): fanotify agent in Platform/Linux, same API names. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0-windows10.0.19041.0;net10.0</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <SupportedOSPlatformVersion></SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <ProjectReference Include="..\Marea.CloudFiles\Marea.CloudFiles.csproj" />
    <Compile Remove="Platform\Linux\**" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Marea.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Translations: one file per language, English as fallback. -->
    <EmbeddedResource Include="i18n\*.json" LogicalName="Marea.Core.i18n.%(Filename).json" />
  </ItemGroup>
</Project>
